{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/social-card",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/social-card/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/social-card/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/social-card/og.png",
      "destination": "/og.png"
    },
    {
      "source": "/social-card/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/social-card",
      "destination": "/index.html"
    },
    {
      "source": "/social-card/",
      "destination": "/index.html"
    },
    {
      "source": "/social-card/:path*",
      "destination": "/index.html"
    }
  ]
}
