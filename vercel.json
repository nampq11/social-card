{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/social-card",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/social-card/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/social-card/avatar.png",
      "destination": "/avatar.png"
    },
    {
      "source": "/social-card/demo-shot.png",
      "destination": "/demo-shot.png"
    },
    {
      "source": "/social-card/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/social-card",
      "destination": "/index.html"
    },
    {
      "source": "/social-card/",
      "destination": "/index.html"
    },
    {
      "source": "/social-card/:path*",
      "destination": "/index.html"
    }
  ]
}
