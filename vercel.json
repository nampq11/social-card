{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/social-card/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/social-card/avatar.png",
      "destination": "/avatar.png"
    },
    {
      "source": "/social-card/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/social-card",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
